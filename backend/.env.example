# Register a GitHub OAuth App and use its client ID and client secret.
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
# The development frontend proxies /auth to the backend. Register this exact URL.
GITHUB_CALLBACK_URL=http://127.0.0.1:5173/auth/github/callback

# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use at least 32 characters; keep it stable and shared by every API instance.
# This secret also encrypts server-side OAuth tokens. Rotating it signs users out
# and requires GitHub reauthorization. Never commit a real value.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional separate encryption/signing secret; otherwise SESSION_SECRET is used.
# APP_SECRET=another-persistent-random-value-at-least-32-characters

GROQ_API_KEY=your-groq-api-key

# Optional: defaults to a local SQLite database if omitted.
# DATABASE_URL=postgresql://user:password@localhost:5432/repoagent
# From your own computer, use Render's External Database URL (Connect > External).
# Render's internal dpg-... hostname only works on Render's private network.
# Keep the internal URL in your Render service's environment, not this local file.
# External Render connections should include sslmode=require in the URL query.

# Where the browser returns after GitHub authentication.
FRONTEND_URL=http://127.0.0.1:5173

# Only needed when the frontend calls the API across origins. Comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173

# Defaults to true for an HTTPS callback URL; false for local HTTP development.
# SESSION_HTTPS_ONLY=true

# Default lax works with the local Vite proxy or a same-origin production proxy.
SESSION_SAME_SITE=lax
# For a frontend on a different site calling the HTTPS API directly:
# SESSION_SAME_SITE=none
# SESSION_HTTPS_ONLY=true
# Browsers may still block third-party cookies; prefer a same-origin proxy.
# The short-lived GitHub OAuth flow cookie always remains SameSite=Lax.

# Visual preview hosts must be separate from the workspace/API origin.
# Local URLs look like http://<capability>.localhost:8000/.
# Match these with frontend VITE_PREVIEW_ORIGIN=http://*.localhost:8000.
PREVIEW_DOMAIN=localhost
PREVIEW_SCHEME=http
PREVIEW_PORT=8000

# Vite previews need a running Linux Docker engine; static HTML does not.
PREVIEW_BUILDER_IMAGE=node:22-bookworm-slim
# Optional: defaults to backend/preview_data. Keep outside repository workspaces.
# PREVIEW_STORAGE_PATH=/var/lib/repoagent/previews

# Production: dedicated wildcard DNS + HTTPS, preserving Host through the proxy.
# PREVIEW_DOMAIN=preview.example.net
# PREVIEW_SCHEME=https
# PREVIEW_PORT=
# Frontend build: VITE_PREVIEW_ORIGIN=https://*.preview.example.net
